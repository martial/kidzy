    "unlock.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint, Shapes, Guitar and Parrot join the sea and the animals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peinture, Formes, Guitare et Perroquet rejoignent la mer et les animaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintura, Formas, Guitarra y Loro se suman al mar y a los animales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pittura, Forme, Chitarra e Pappagallo si aggiungono al mare e agli animali."
          }
        }
      }
    },

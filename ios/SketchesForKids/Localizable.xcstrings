    "parent.mic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parrot listens on this phone only. Nothing is recorded or sent anywhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le perroquet écoute sur ce téléphone seulement. Rien n'est enregistré ni envoyé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El loro solo escucha en este teléfono. No se graba ni se envía nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pappagallo ascolta solo su questo telefono. Niente viene registrato né inviato."

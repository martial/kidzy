#!/bin/sh
# Refuse to push the private `youtube` branch to the public origin.
# Install with: git config core.hooksPath ops/git-hooks
remote="$1"
while read -r local_ref _local_sha _remote_ref _remote_sha; do
  case "$local_ref" in
    refs/heads/youtube|refs/heads/youtube/*)
      if [ "$remote" = "origin" ]; then
        echo "pre-push: branch 'youtube' is private; push it to the 'private' remote only." >&2
        exit 1
      fi
      ;;
  esac
done
exit 0

    "t-app": { "x": 0, "y": -260, "text": "The app", "kind": "title1", "maxW": 2740 },
    "n-app": { "x": 2830, "y": 0, "w": 320, "text": "A sunny toy cabinet: each toy is a glossy 3D toy in its own coloured cubby, big enough for a two-year-old's thumb, and it bobs gently so it asks to be touched. Kid screens have no text. Free: the sea and the animals. Paint, shapes, guitar and parrot open with one purchase, behind a sum only a grown-up can do. Parent screens are drawn in English; French ships too.", "fill": "orange" },
    "t-store": { "x": 0, "y": 1000, "text": "App Store screenshots", "kind": "title1", "maxW": 2470 },
    "n-store": { "x": 2550, "y": 1250, "w": 320, "text": "Five screenshots, 1290 × 2796 when exported at 3×. Each one has its own cubby colour so the carousel reads as a rainbow of toys, a real capture of the toy in the phone, and one 3D toy breaking out of the frame. Captions are short so they translate.", "fill": "blue" },
